# Public issuer and WebAuthn origin. Set these before the first boot.
ZITADEL_EXTERNALDOMAIN=identity.example.test
ZITADEL_EXTERNALPORT=443
ZITADEL_EXTERNALSECURE=true
ZITADEL_TLS_ENABLED=false
ZITADEL_PORT=8080

# First instance. Its password is injected by the named Podman secret.
ZITADEL_FIRSTINSTANCE_INSTANCENAME=Tessera
ZITADEL_FIRSTINSTANCE_ORG_NAME=Shippin
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_USERNAME=tessera-admin
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_FIRSTNAME=Tessera
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_LASTNAME=Administrator
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_EMAIL_ADDRESS=admin@identity.example.test
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_EMAIL_VERIFIED=true
ZITADEL_WEBAUTHNNAME=Tessera

# Database connection waits for an externally supervised PostgreSQL service.
# The credential-bearing DSN is injected by the named Podman secret.
ZITADEL_DATABASE_POSTGRES_AWAITINITIALCONN=5m
ZITADEL_DATABASE_POSTGRES_MAXOPENCONNS=20
ZITADEL_DATABASE_POSTGRES_MAXIDLECONNS=10

# Reviewed desired-state files; never place credentials in this directory.
ZITADEL_BLUEPRINTS_DIR=/etc/tessera/blueprints

# Container-native observability.
ZITADEL_TELEMETRY_ENABLED=false
ZITADEL_INSTRUMENTATION_SERVICENAME=tessera
ZITADEL_INSTRUMENTATION_LOG_STDERR=json
