    }
  ],
  "path_rules": [
    {
      "id": "tessera-management-proto",
      "patterns": [
        "proto/tessera/**"
      ],
      "source_id": "tessera-native",
      "relationship": "native",
      "reason": "Tessera-owned provider-neutral management protocol."
    },
    {
      "id": "tessera-shippin-contract-fixtures",
      "patterns": [
        "testdata/shippin/**"
      ],
      "source_id": "tessera-native",
      "relationship": "native",
      "reason": "Provider-neutral fixtures consumed by the Shippin server-side adapter."
    },
    {
      "id": "authentik-blueprint-inspiration",
      "patterns": [
        "backend/v1/domain/blueprint*.go",
        "backend/v1/storage/blueprint/**",
        "backend/v1/storage/seat/applier*.go",
        "backend/v1/storage/seat/atomicity_test.go",
        "blueprints/dev/seats.yaml.tmpl",
        "cmd/blueprint/**"
      ],
      "source_id": "tessera-native",
      "relationship": "native",
      "inspired_by": [
        "authentik-concepts"
      ],
      "reason": "Authentik blueprint concepts reimplemented over Tessera's domain and transaction boundary."
    },
    {
      "id": "authentik-flow-inspiration",
      "patterns": [
        "backend/v1/domain/flow*.go",
        "backend/v1/storage/flow/**",
        "backend/v1/storage/migration/002_flows.go",
        "backend/v1/storage/migration/002_flows/**",
        "backend/v1/storage/seat/crossmodel_test.go",
        "blueprints/dev/flows.yaml",
        "dev/flow-probe.sh",
        "internal/api/flows/**"
      ],
      "source_id": "tessera-native",
      "relationship": "native",
      "inspired_by": [
        "authentik-concepts"
      ],
      "reason": "Authentik flow and stage concepts reimplemented in Go over Tessera sessions."
    },
    {
      "id": "tessera-v1-domain",
      "patterns": [
        "backend/v1/**"
      ],
      "source_id": "tessera-native",
      "relationship": "native",
      "reason": "Tessera-owned provider-neutral domain and storage code added after the trunk import."
    },
    {
      "id": "tessera-seat-command",
      "patterns": [
        "cmd/seat/**"
      ],
      "source_id": "tessera-native",
      "relationship": "native",
      "reason": "Tessera seat management surface."
    },
    {
      "id": "tessera-seat-claims",
      "patterns": [
        "internal/api/oidc/seat_claims*.go",
        "internal/domain/seat_scope.go"
      ],
      "source_id": "tessera-native",
      "relationship": "native",
      "reason": "Tessera seat-token minting and workspace audience rules."
    }
  ],
  "reviewed_path_patterns": [
    "backend/**",
    "cmd/**",
    "internal/**",
    "proto/**",
    "pkg/**",
    "openapi/**",
    "statik/**",
    "main.go",
    "go.mod",
    "go.sum",
    "buf.gen.yaml",
    "buf.work.yaml"
  ],
  "default_classification": {
    "source_id": "tessera-native",
    "relationship": "native",
    "rule_id": "tessera-native-default"
  }
}
