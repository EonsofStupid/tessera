    },
    {
      "id": "zitadel-proto",
      "name": "ZITADEL protocol definitions",
      "repository": "https://github.com/zitadel/zitadel",
      "revision": "632a5196800c5919e5043d482846ec59d7fad88e",
      "revision_status": "local reference snapshot; exact import verification is P0.5",
