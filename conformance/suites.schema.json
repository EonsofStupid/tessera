{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shippin.cloud/tessera/conformance-suites.v1.json",
  "title": "Tessera conformance suite registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suites"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "tessera.conformance-suites.v1"},
    "suites": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capabilityId", "conformanceId", "status", "profiles", "cases"],
        "properties": {
          "capabilityId": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
          "conformanceId": {"type": "string", "pattern": "^tessera\\.conformance\\.[a-z0-9-]+\\.v1$"},
          "status": {"enum": ["planned", "implemented", "verified"]},
          "profiles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "cases": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "class", "profile", "requirement"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
                "class": {"enum": ["positive", "negative", "failure", "recovery", "accessibility"]},
                "profile": {"type": "string"},
                "requirement": {"type": "string", "minLength": 20}
              }
            }
          }
        }
      }
    }
  }
}
