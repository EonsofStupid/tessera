# Public issuer and WebAuthn origin. Set these before the first boot.
NOMEN_EXTERNALDOMAIN=identity.example.test
NOMEN_EXTERNALPORT=443
NOMEN_EXTERNALSECURE=true
NOMEN_TLS_ENABLED=false
NOMEN_PORT=8080

# First instance. Its password is injected by the named Podman secret.
NOMEN_FIRSTINSTANCE_INSTANCENAME=Nomen
NOMEN_FIRSTINSTANCE_ORG_NAME=Nomen
NOMEN_FIRSTINSTANCE_ORG_HUMAN_USERNAME=nomen-admin
NOMEN_FIRSTINSTANCE_ORG_HUMAN_FIRSTNAME=Nomen
NOMEN_FIRSTINSTANCE_ORG_HUMAN_LASTNAME=Administrator
NOMEN_FIRSTINSTANCE_ORG_HUMAN_EMAIL_ADDRESS=admin@identity.example.test
NOMEN_FIRSTINSTANCE_ORG_HUMAN_EMAIL_VERIFIED=true
NOMEN_WEBAUTHNNAME=Nomen

# Database connection waits for an externally supervised PostgreSQL service.
# The credential-bearing DSN is injected by the named Podman secret.
NOMEN_DATABASE_POSTGRES_AWAITINITIALCONN=5m
NOMEN_DATABASE_POSTGRES_MAXOPENCONNS=20
NOMEN_DATABASE_POSTGRES_MAXIDLECONNS=10

# Reviewed desired-state files; never place credentials in this directory.
NOMEN_BLUEPRINTS_DIR=/etc/nomen/blueprints

# Container-native observability.
NOMEN_TELEMETRY_ENABLED=false
NOMEN_INSTRUMENTATION_SERVICENAME=nomen
NOMEN_INSTRUMENTATION_LOG_STDERR=json
