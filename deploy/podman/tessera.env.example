# Public issuer and WebAuthn origin. Set these before the first boot.
TESSERA_EXTERNALDOMAIN=identity.example.test
TESSERA_EXTERNALPORT=443
TESSERA_EXTERNALSECURE=true
TESSERA_TLS_ENABLED=false
TESSERA_PORT=8080

# First instance. Its password is injected by the named Podman secret.
TESSERA_FIRSTINSTANCE_INSTANCENAME=Tessera
TESSERA_FIRSTINSTANCE_ORG_NAME=Tessera
TESSERA_FIRSTINSTANCE_ORG_HUMAN_USERNAME=tessera-admin
TESSERA_FIRSTINSTANCE_ORG_HUMAN_FIRSTNAME=Tessera
TESSERA_FIRSTINSTANCE_ORG_HUMAN_LASTNAME=Administrator
TESSERA_FIRSTINSTANCE_ORG_HUMAN_EMAIL_ADDRESS=admin@identity.example.test
TESSERA_FIRSTINSTANCE_ORG_HUMAN_EMAIL_VERIFIED=true
TESSERA_WEBAUTHNNAME=Tessera

# Database connection waits for an externally supervised PostgreSQL service.
# The credential-bearing DSN is injected by the named Podman secret.
TESSERA_DATABASE_POSTGRES_AWAITINITIALCONN=5m
TESSERA_DATABASE_POSTGRES_MAXOPENCONNS=20
TESSERA_DATABASE_POSTGRES_MAXIDLECONNS=10

# Reviewed desired-state files; never place credentials in this directory.
TESSERA_BLUEPRINTS_DIR=/etc/tessera/blueprints

# Container-native observability.
TESSERA_TELEMETRY_ENABLED=false
TESSERA_INSTRUMENTATION_SERVICENAME=tessera
TESSERA_INSTRUMENTATION_LOG_STDERR=json
