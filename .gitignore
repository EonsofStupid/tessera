# Never under W: no private keys, client secrets, tokens, cookies, OAuth
# sessions or application databases (../../CLYFFY.md). Test fixtures are
# generated at run time, never committed.
*.pem
*.key
*.p12
*.pfx
*.jwk
*.jwks
secrets/
.env
.env.*
node_modules/
/target/
web/playwright-report/
web/test-results/

# Runtime state for the workspace terminal host — sockets and pids.
.automaton/

# Upstream trees we build from — reference, not vendored.
# Cloned with: git clone --depth 1 (see docs/03-roadmap.md)
upstream/

# Dev database and build outputs — disposable, rebuilt by dev/up.sh.
.pgdata/
.artifacts/

# Generated by dev/up.sh and the container build. Hand-written helpers under
# pkg/grpc remain tracked; only protocol output is ignored.
pkg/grpc/**/*.pb*.go
pkg/grpc/**/*connect/*.connect.go
openapi/v2/
apps/docs/

# chatmirror — local AI session mirrors (never commit: may contain tokens)
.chat/

# agent worktrees — local scratch, never part of the tree
.claude/worktrees/
