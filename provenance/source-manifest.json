    {
      "id": "authentik-concepts",
      "name": "authentik",
      "repository": "https://github.com/goauthentik/authentik",
      "revision": "64d4b97dbd81a65a3dbe8e0e3dc7d13cb8831ff8",
      "revision_status": "local reference snapshot used for documented design study",
      "license_expression": "MIT",
